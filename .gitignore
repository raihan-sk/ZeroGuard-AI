cat >> .gitignore <<'EOF'

# Local development files
.venv/
data/
demo/
results/
__pycache__/
*.pyc
.DS_Store
.env
.streamlit/secrets.toml
dashboard/app_backup.py

# Do not publish experimental models
models/*.joblib
!models/zeroguard_deploy.joblib
EOF
